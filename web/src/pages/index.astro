---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f1210" />
    <title>刷卡登錄雷達</title>
    <meta
      name="description"
      content="台灣跨銀行信用卡活動登錄時點與活動條件。標示登錄與消費的先後順序，避免登錄成功卻白刷。"
    />
    <meta property="og:title" content="刷卡登錄雷達" />
    <meta
      property="og:description"
      content="什麼時候要登錄、從哪裡登錄、登錄一次夠不夠 —— 以及登錄與消費的先後順序。"
    />
    <meta property="og:type" content="website" />
  </head>
  <body data-base={base}>
    <a class="skip" href="#main">跳到主要內容</a>

    <div class="shell">
      <header class="site">
        <div class="brand">
          <h1>刷卡登錄雷達</h1>
          <span class="tag">台灣跨銀行 · 官方公開資料</span>
        </div>
        <p class="lede">
          回答兩件事：<strong>我什麼時候要登錄</strong>，以及
          <strong>登錄與消費的先後順序是什麼</strong>。後者決定你會不會登錄成功卻白刷。
        </p>
        <p id="updated"></p>
        <div id="staleness" hidden></div>

        <div class="stats" id="stats"></div>

        <div class="feeds">
          <button class="action" id="subscribe" type="button" aria-expanded="false"
            aria-controls="subscribe-panel">訂閱登錄提醒行事曆</button>
          <a class="action ghost" id="download-ics" href="#" download>下載 .ics</a>
        </div>

        <!-- 訂閱方式因平台而異，而且差異不是小事：Apple 一鍵就好，Google 日曆
             必須用瀏覽器加一次（Android 的 App 裡沒有這個功能），其他行事曆
             一律是「貼上網址」。與其猜使用者的平台，不如三條路都給。 -->
        <div class="subscribe-panel" id="subscribe-panel" hidden>
          <div class="sub-row">
            <span class="sub-label">iPhone／iPad／Mac</span>
            <a class="action ghost" id="sub-apple" href="#">一鍵訂閱</a>
            <span class="hint">會加進「行事曆」App 並自動更新</span>
          </div>
          <div class="sub-row">
            <span class="sub-label">Google 日曆（含 Android）</span>
            <a class="action ghost" id="sub-google" href="#" target="_blank"
              rel="noopener noreferrer">用瀏覽器加入</a>
            <span class="hint">
              手機的 Google 日曆 App 不能自己加訂閱網址，用瀏覽器加一次之後，
              手機就會自動同步。Google 大約每幾小時才會抓一次更新。
            </span>
          </div>
          <div class="sub-row">
            <span class="sub-label">Outlook／Thunderbird／三星行事曆等</span>
            <button class="action ghost" id="sub-copy" type="button">複製訂閱網址</button>
            <code class="sub-url" id="sub-url"></code>
          </div>
          <p class="hint">
            「下載 .ics」是一次性匯入的備案 —— 匯入之後不會再更新，
            活動有異動要重新下載。能訂閱就訂閱。
          </p>
        </div>
      </header>

      <nav id="tabs" aria-label="檢視"></nav>
      <div id="controls"></div>
      <div id="picker" hidden></div>

      <main id="main" tabindex="-1">
        <div id="view">
          <div class="empty">載入官方活動資料中…</div>
        </div>
      </main>

      <footer class="site">
        <p>
          只讀取公開的官方活動資訊。不登入銀行帳戶、不代為執行活動登錄、不收集卡號或個人資料。
        </p>
        <p>
          「我的銀行」與「已登錄」只存在這台裝置的瀏覽器裡，不會上傳。
          實際名額、資格與回饋一律以銀行官方公告為準。
        </p>
        <p>
          <a href="https://github.com/garychen-soc/tw-card-registration-radar">原始碼與資料管線</a>
        </p>
      </footer>
    </div>

    <script>
      import "../lib/app";
    </script>
  </body>
</html>
