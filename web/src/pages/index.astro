---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>刷卡登錄雷達</title>
    <meta
      name="description"
      content="台灣各銀行信用卡活動的登錄時點。每個時點附官方原文、套用假日順延，並區分子活動。"
    />
    <meta property="og:title" content="刷卡登錄雷達" />
    <meta property="og:description" content="什麼時候開放登錄、從哪裡登錄、要不要每月重登 —— 每一筆都附官方原文。" />
    <meta property="og:type" content="website" />
  </head>
  <body data-base={base}>
    <a class="skip" href="#view">跳到主要內容</a>
    <div class="shell">
      <header class="site">
        <h1>刷卡登錄雷達</h1>
        <p class="lede">
          台灣各家銀行信用卡活動的<strong>登錄開放時點</strong>。每個時點都附官方原文，
          條款寫「遇假日順延」的已依行政院辦公日曆順延，同頁多個子活動分開列出。
        </p>
        <p id="updated" class="muted"></p>
        <p id="staleness" class="banner" hidden></p>
        <div class="stats" id="stats"></div>

        <details class="subscribe">
          <summary>訂閱登錄提醒行事曆（開放前 10 分鐘提醒）</summary>
          <div class="sub-row">
            <span class="sub-label">iPhone／iPad／Mac</span>
            <a class="btn" id="sub-apple" href="#">一鍵訂閱</a>
          </div>
          <div class="sub-row">
            <span class="sub-label">Google 日曆（含 Android）</span>
            <a class="btn" id="sub-google" href="#" target="_blank" rel="noopener">用瀏覽器加入</a>
            <span class="muted">Android App 無法直接訂閱，用瀏覽器加一次後手機會自動同步。</span>
          </div>
          <div class="sub-row">
            <span class="sub-label">Outlook／其他</span>
            <input id="sub-url" readonly aria-label="行事曆訂閱網址" />
            <button class="btn" id="sub-copy" type="button">複製網址</button>
          </div>
        </details>
      </header>

      <nav class="tabs" aria-label="檢視">
        <button type="button" data-tab="timeline" aria-selected="true">登錄時間軸</button>
        <button type="button" data-tab="catalog">活動目錄</button>
        <button type="button" data-tab="review">需人工確認</button>
        <button type="button" data-tab="sources">來源狀態</button>
      </nav>

      <div class="filters">
        <input id="q" type="search" placeholder="搜尋活動、銀行、通路" aria-label="搜尋" />
        <select id="bank" aria-label="銀行"><option value="">全部銀行</option></select>
        <label class="check"><input id="mine" type="checkbox" />只看我的銀行</label>
        <span id="hide-done-wrap"><label class="check"><input id="hide-done" type="checkbox" />隱藏已登錄</label></span>
        <span id="reg-only-wrap" hidden><label class="check"><input id="reg-only" type="checkbox" />只看需登錄</label></span>
        <details class="mybanks">
          <summary>設定我的銀行</summary>
          <div id="mybanks-list"></div>
        </details>
      </div>

      <main id="view" aria-live="polite"><p class="muted">載入中…</p></main>

      <footer class="foot">
        <p>
          資料取自各銀行官方公開頁面，每日於本機更新。登錄時點由程式比對官方原文產生；名額、資格與回饋一律以銀行公告為準。
          「已登錄」與「我的銀行」只存在你的瀏覽器。
        </p>
      </footer>
    </div>
    <script>
      import "../lib/app.ts";
    </script>
  </body>
</html>
